# Copia este archivo a `.env` y completa los valores.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_repo_interno
DB_USER=root
DB_PASSWORD=cambia_esta_password

# JWT — genera cada secreto con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=genera_un_secreto_aleatorio
JWT_REFRESH_SECRET_KEY=genera_otro_secreto_distinto
ACCESS_TOKEN_EXPIRE_MINUTES=15

# CORS — orígenes permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:4321

# (Opcional) carpeta donde se guardan los documentos subidos
# UPLOAD_DIR=../uploaded_files
