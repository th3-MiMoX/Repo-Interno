---
import Layout from '../layouts/Layout.astro';
import '@styles/unauthorized.css';
---

<Layout title="Acceso denegado — Archivo">
  <main class="denied">
    <div class="denied__folder">
      <span class="denied__tab">Expediente · Acceso restringido</span>

      <div class="denied__card">
        <div class="denied__redactions" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="denied__stampwrap">
          <svg class="denied__stamp" viewBox="0 0 220 220" aria-hidden="true">
            <defs>
              <filter id="stampRough" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="6" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="4.5" />
              </filter>
              <path id="ringTop" d="M 26 110 A 84 84 0 0 1 194 110" />
              <path id="ringBottom" d="M 194 110 A 84 84 0 0 1 26 110" />
            </defs>
            <g filter="url(#stampRough)" fill="none" stroke="currentColor">
              <circle cx="110" cy="110" r="100" stroke-width="3" />
              <circle cx="110" cy="110" r="86" stroke-width="1.3" />
              <text font-family="var(--font-mono)" font-size="10.5" letter-spacing="3" fill="currentColor" stroke="none">
                <textPath href="#ringTop" startOffset="50%" text-anchor="middle">ARCHIVO · REPOSITORIO DOCUMENTAL</textPath>
              </text>
              <text font-family="var(--font-mono)" font-size="10.5" letter-spacing="3" fill="currentColor" stroke="none">
                <textPath href="#ringBottom" startOffset="50%" text-anchor="middle">NIVEL DE AUTORIZACIÓN INSUFICIENTE</textPath>
              </text>
              <text x="110" y="103" font-family="var(--font-display)" font-size="30" font-weight="700" fill="currentColor" stroke="none" text-anchor="middle">DENEGADO</text>
              <line x1="70" y1="116" x2="150" y2="116" stroke-width="1.5" />
              <text x="110" y="132" font-family="var(--font-mono)" font-size="11" letter-spacing="4" fill="currentColor" stroke="none" text-anchor="middle">ART. 403</text>
            </g>
          </svg>
        </div>

        <p class="eyebrow denied__code">Error 403 · Acceso restringido</p>
        <h1>No tienes autorización para consultar este expediente</h1>
        <p class="denied__lede">
          Tu cuenta no cuenta con los permisos necesarios para acceder a esta sección.
          Si crees que se trata de un error, contacta al administrador del sistema.
        </p>

        <div class="denied__actions">
          <a href="/" class="btn">Volver al inicio</a>
          <button type="button" class="btn btn--ghost" data-denied-logout>Cerrar sesión</button>
        </div>
      </div>
    </div>

    <p class="denied__colophon">
      Archivo · Sistema interno de gestión documental · Acceso restringido al personal autorizado
    </p>
  </main>

  <script src="/src/lib/unauthorized.ts"></script>
</Layout>
