---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import UploadDocumentModal from '../components/UploadDocumentModal.astro';
import EditDocumentModal from '../components/EditDocumentModal.astro';
import CreateCategoryModal from '../components/CreateCategoryModal.astro';
import RegisterUserModal from '../components/RegisterUserModal.astro';
import '@styles/dashboard.css';

---

<Layout title="Panel — Archivo">
  <Header active="panel" showUserMenu />

  <main class="shell">
    <div class="pagehead">
      <p class="eyebrow">Panel de control</p>
      <h2>Panel</h2>
      <p class="pagehead__lede">
        Consulta el historial de documentos subidos y, si tienes permisos de
        administrador, gestiona las cuentas de acceso a la plataforma.
      </p>
    </div>

    <nav class="tabs" aria-label="Secciones del panel">
      <button type="button" class="tabs__btn is-active" data-tab="documentos">Documentos</button>
      <button type="button" class="tabs__btn" data-tab="usuarios" data-admin-only>Usuarios</button>
      <button type="button" class="tabs__btn" data-tab="categorias" data-admin-only>Categorías</button>
    </nav>

    <section class="panel" data-panel="documentos">
      <div class="panel__head">
        <div>
          <h3>Historial de documentos</h3>
          <p class="panel__count"><span data-documentos-total>0</span> archivos registrados</p>
        </div>
        <button type="button" class="btn" data-abrir-modal-documento>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Subir documento
        </button>
      </div>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Archivo</th>
              <th>Categoría</th>
              <th>Fecha</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody data-documentos-body></tbody>
        </table>
      </div>
    </section>

    <section class="panel" data-panel="usuarios" data-admin-only hidden>
      <div class="panel__head">
        <div>
          <h3>Usuarios registrados</h3>
          <p class="panel__count"><span data-usuarios-total>0</span> cuentas en la plataforma</p>
        </div>
        <button type="button" class="btn" data-abrir-modal-usuario>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Nuevo usuario
        </button>
      </div>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Rol</th>
              <th>Estado</th>
              <th>Actualizado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody data-usuarios-body></tbody>
        </table>
      </div>
    </section>

    <section class="panel" data-panel="categorias" data-admin-only hidden>
      <div class="panel__head">
        <div>
          <h3>Categorías</h3>
          <p class="panel__count"><span data-categorias-total>0</span> categorías registradas</p>
        </div>
        <button type="button" class="btn" data-abrir-modal-categoria>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v16m8-8H4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Nueva categoría
        </button>
      </div>

      <ul class="category-chips" data-categorias-lista></ul>
    </section>
  </main>

  <footer class="colophon">
    <p>Archivo · Sistema interno de gestión documental · Acceso restringido al personal autorizado</p>
  </footer>

  <UploadDocumentModal id="modal-documento" />
  <EditDocumentModal id="modal-editar-documento" />
  <CreateCategoryModal id="modal-categoria" />
  <RegisterUserModal id="modal-usuario" />

  <script src="/src/lib/dashboard.ts"></script>
</Layout>
