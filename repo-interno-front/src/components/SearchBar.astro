---
import "@styles/searchbar.css"

interface Props {
  total: number;
}

const { total } = Astro.props;
---

<div class="toolbar">
  <div class="toolbar__search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
      <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    <input
      type="search"
      placeholder="Buscar por código, título o autor…"
      aria-label="Buscar documentos"
      data-search-input
    />
    <kbd>/</kbd>
  </div>

  <div class="toolbar__filters">
    <button type="button" class="btn" data-abrir-modal-documento hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Subir documento
    </button>
  </div>
</div>

<div class="resultline">
  <p>
    <strong data-result-count>{total}</strong> expedientes
    <span data-result-scope>en el archivo</span>
  </p>
  <p class="resultline__updated eyebrow">Sincronizado hace 4 min</p>
</div>


