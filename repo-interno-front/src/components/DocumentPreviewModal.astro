---
import Modal from './Modal.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<Modal id={id} titulo="Visualizar documento" size="wide">
  <div class="doc-preview">
    <div class="doc-preview__toolbar">
      <a class="btn btn--ghost" data-doc-preview-nueva-pestana target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Abrir en pestaña nueva
      </a>
      <a class="btn" data-doc-preview-download download>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Descargar
      </a>
    </div>
    <div class="doc-preview__body" data-doc-preview-body></div>
  </div>
</Modal>
